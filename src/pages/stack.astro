---
import Base from '../layouts/Base.astro';
import StackBlock from '../components/StackBlock.astro';
import stack from '../data/stack.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const LIVE = new Set(['work/jev', 'work/platform', 'work/babyloop', 'work/uptime', 'work/interview-bootcamp', 'how-i-work']);
---

<Base title="Stack — Vitalii Ryzhenko" description="Technologies I use at work and in my own projects, with versions where they are pinned.">
  <h1>Stack</h1>
  <p>
    What I work with professionally (from my CV), and what each of my own projects runs on. Versions come from each
    project's manifest (minimum versions where it uses ranges).
  </p>

  <h2>At work</h2>
  <StackBlock heading={false} />

  <h2>In my projects</h2>
  {
    stack.projects.map((p) => (
      <section class="proj">
        <h3>
          {'link' in p && p.link && LIVE.has(p.link) ? (
            <a href={`${base}/${p.link}/`}>{p.name}</a>
          ) : 'href' in p && p.href ? (
            <a href={p.href} rel="noopener">
              {p.name} ↗
            </a>
          ) : (
            p.name
          )}
        </h3>
        <StackBlock project={p.id} heading={false} />
      </section>
    ))
  }
</Base>

<style>
  .proj {
    margin: 1.6rem 0;
  }
  .proj h3 {
    margin-bottom: 0.2rem;
  }
</style>
