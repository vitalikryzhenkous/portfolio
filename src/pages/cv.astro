---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
import cv from '../data/cv.json';
import stack from '../data/stack.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Base title="CV — Vitalii Ryzhenko" description="CV of Vitalii Ryzhenko, Applied AI / Forward Deployed Engineer. Download as PDF or print.">
  <div class="actions no-print">
    {
      profile.cv.map((c) => (
        <a class="btn" href={`${base}/${c.file}`} download data-track={`cv-download:${c.id}:cv-page`}>
          Download PDF — {c.label}
        </a>
      ))
    }
    <button type="button" class="btn" id="print-cv" data-track="cv-print">Print this page</button>
  </div>

  <article class="cv">
    <header>
      <h1>{profile.name}</h1>
      <p class="headline">{cv.headline}</p>
      <p class="contact">
        {profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
        <a href={profile.links.linkedin}>linkedin.com/in/vitalii-ryzhenko-366858116</a>
      </p>
    </header>

    <h2>Summary</h2>
    <p>{cv.summary}</p>

    <h2>Technical skills</h2>
    <ul class="skills">
      {
        stack.professional.groups.map((g) => (
          <li>
            <strong>{g.name}:</strong> {g.items.join(', ')}
          </li>
        ))
      }
    </ul>

    <h2>Experience</h2>
    {
      cv.experience.map((e) => (
        <section class="job">
          <h3>
            {e.company} — {e.role}
          </h3>
          <p class="period">
            {e.period}
            {'context' in e && e.context ? ` · ${e.context}` : ''}
          </p>
          {e.groups.map((g) => (
            <>
              {g.name && <h4>{g.name}</h4>}
              <ul>
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </>
          ))}
        </section>
      ))
    }
    <p><strong>Earlier</strong> — {cv.earlier}</p>

    <h2>Education</h2>
    <p>{cv.education}</p>

    <h2>Certifications</h2>
    <p>{profile.certifications.map((c) => `${c.issuer}: ${c.name}`).join(' · ')}</p>

    <h2>Languages</h2>
    <p>{cv.languages}</p>
  </article>
</Base>

<script>
  document.getElementById('print-cv')?.addEventListener('click', () => window.print());
</script>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }
  .btn {
    font: inherit;
    font-size: 0.92rem;
    padding: 0.5rem 0.95rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--fg);
    text-decoration: none;
    cursor: pointer;
  }
  .btn:hover,
  .btn:focus-visible {
    border-color: var(--accent);
  }
  .cv h1 {
    margin: 0;
  }
  .headline {
    margin: 0.2rem 0;
    font-weight: 600;
    color: var(--accent);
  }
  .contact,
  .period {
    color: var(--muted);
    font-size: 0.9rem;
    margin: 0.2rem 0;
  }
  .cv h2 {
    margin: 1.6rem 0 0.4rem;
    font-size: 1.15rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.2rem;
  }
  .cv h3 {
    margin: 1rem 0 0;
    font-size: 1rem;
  }
  .cv h4 {
    margin: 0.6rem 0 0.2rem;
    font-size: 0.9rem;
  }
  .cv ul {
    margin: 0.2rem 0;
    padding-left: 1.2rem;
  }
  .cv li {
    margin-bottom: 0.25rem;
    font-size: 0.95rem;
  }
  .skills {
    list-style: none;
    padding-left: 0 !important;
  }
</style>
