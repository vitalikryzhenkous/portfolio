---
import Base from '../layouts/Base.astro';
import profile from '../data/profile.json';
import cv from '../data/cv.json';
import snapOss from '../../data/snapshots/2026-11-02.json';
import ossCards from '../data/oss-highlights.json';
import more from '../data/more-work.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const creatio = cv.experience[0]!;
const oss = snapOss.oss;
const prUrl = (repo: string, n: number) => `https://github.com/${repo}/pull/${n}`;
const short = (repo: string) => repo.split('/')[1]!;
const prList = (repo: string) =>
  `https://github.com/${repo}/pulls?q=${encodeURIComponent(`is:pr author:${oss.author}`)}`;
const ai = creatio.groups.find((g) => g.name === 'AI & agent tooling')!.items;
const l4 = creatio.groups.find((g) => g.name === 'Customer escalations (L4)')!.items;
// Three AI bullets for the home page (full list on /cv); the PR count lives in the open-source block below.
const aiShort = [0, 2, 3].map((i) => ai[i]!.replace(/; \d+ merged PRs[^.]*\.?$/, '.').replace(/\.\.$/, '.'));
const byIssuer = profile.certifications.reduce<Record<string, typeof profile.certifications>>((acc, c) => {
  (acc[c.issuer] ??= []).push(c);
  return acc;
}, {});

const work = [
  {
    title: 'jev — privacy-first LLM router',
    text: 'Built so sensitive requests stay on a CPU-only home server and the rest go to the cheapest Claude model that can do the job. Model and policy choices are backed by preregistered evals.',
    href: `${base}/work/jev/`,
    tag: 'Case study',
  },
  {
    title: 'Agent platform with an independent verifier',
    text: 'Coding agents change real infrastructure only under written rules; a second agent with a fresh context checks every plan and result.',
    href: `${base}/work/platform/`,
    tag: 'Case study',
  },
  {
    title: 'babyloop — a mobile app built with an agent team',
    text: 'Spec-first pipeline with independent reviewer agents and tests written before code; hooks block shortcuts; every task leaves a metrics row. Private repo, demo on request.',
    href: `${base}/work/babyloop/`,
    tag: 'Case study',
  },
  {
    title: 'connectiq-watchface-kit',
    text: 'Open source: a Claude Code skill, an MCP server with 5 tools and a 10-task benchmark for building Garmin watch faces. A face built with it is live in the Connect IQ Store.',
    href: 'https://github.com/vitalikryzhenkous/connectiq-watchface-kit',
    tag: 'Open source ↗',
  },
  {
    title: 'donecheck',
    text: 'An independent checker that verifies whether a coding agent did what it was asked. In progress — the repository goes public with its first release.',
    href: null,
    tag: 'In progress',
  },
];
---

<Base
  title="Vitalii Ryzhenko — Applied AI Engineer"
  description="Applied AI / Forward Deployed Engineer. I build production LLM features and AI-agent tooling, backed by systematic evaluation."
>
  <section class="hero">
    <p class="roles">{profile.roles.join(' · ')}</p>
    <h1>I build production LLM features and AI-agent tooling, backed by systematic evaluation.</h1>
    <p class="lead">
      9+ years of full-stack engineering (TypeScript, Angular/React, .NET/Node). At Creatio I build MCP tools, structured
      output features and agent evals; on my own hardware I run a privacy-first LLM router and an agent platform with an
      independent verifier. Before engineering I worked in B2B sales — large deals and negotiations — so I am at home
      in front of customers.
    </p>
    <p class="meta">{profile.location}</p>
    <div class="cta">
      <a class="btn btn-primary" href={profile.links.booking} rel="noopener" data-track="book-call:hero">Book a 30-min call</a>
      <a class="btn" href={`${base}/${profile.cv[0]!.file}`} download data-track="cv-download:applied-ai:home">Download CV (PDF)</a>
      <a class="btn" href={`${base}/cv/`} data-track="cv-page:home">CV page &amp; print</a>
    </div>
  </section>

  <h2>Applied AI at work</h2>
  <p class="sub">{creatio.company} · {creatio.role} · {creatio.period}</p>
  <ul class="bullets">
    {aiShort.map((t) => <li>{t}</li>)}
  </ul>
  <h3 class="oss-h">Open-source contributions</h3>
  <p>
    <strong>{oss.merged_total} merged pull requests</strong> in {oss.repos.length} public repositories
    ({oss.open_total} open), including MCP tools and agent guidance:
    {
      oss.repos.map((r, i) => (
        <>
          {i > 0 ? ' · ' : ' '}
          <a href={prList(r.repo)} rel="noopener">
            {r.repo.split('/')[1]} ({r.merged})
          </a>
        </>
      ))
    }
  </p>
  <ul class="oss-cards">
    {
      ossCards.cards.map((c) => (
        <li class="card">
          <h4>{c.title}</h4>
          <dl>
            <dt>Problem</dt>
            <dd>{c.problem}</dd>
            <dt>Built</dt>
            <dd>{c.built}</dd>
            <dt>Result</dt>
            <dd>{c.result}</dd>
          </dl>
          <p class="pr-links">
            {c.prs.map((p, i) => (
              <>
                {i > 0 ? ' · ' : ''}
                <a href={prUrl(p.repo, p.number)} rel="noopener" data-track={`oss-pr:${short(p.repo)}#${p.number}`}>
                  {short(p.repo)} #{p.number}
                </a>
              </>
            ))}
          </p>
        </li>
      ))
    }
  </ul>
  <p class="sub">Source: GitHub, author {oss.author}, snapshot {snapOss.taken_utc.slice(0, 10)}.</p>

  <h2>In front of customers</h2>
  <ul class="bullets">
    {l4.map((t) => <li>{t}</li>)}
  </ul>

  <h2>Selected work</h2>
  <ul class="cards">
    {
      work.map((w) => (
        <li class:list={['card', { 'card-link': w.href }]}>
          <span class="tag">{w.tag}</span>
          <h3>{w.href ? <a href={w.href}>{w.title}</a> : w.title}</h3>
          <p>{w.text}</p>
        </li>
      ))
    }
  </ul>

  <h2>More work</h2>
  <ul class="cards more">
    {
      more.items.map((m) => (
        <li class="card">
          <span class="tag">{m.visibility}</span>
          <h3>{m.title}</h3>
          <p>{m.what}</p>
          <p class="detail">{m.detail}</p>
          {m.numbers && <p class="nums">{m.numbers}</p>}
          <p class="chips">{m.stack.join(' · ')}</p>
        </li>
      ))
    }
  </ul>

  <h2>Certifications</h2>
  <ul class="certs">
    {
      Object.entries(byIssuer).map(([issuer, list]) => (
        <li>
          <strong>{issuer}</strong> ({list.length}):{' '}
          {list.map((c, i) => (
            <>
              {i > 0 ? ', ' : ''}
              {'url' in c && c.url ? (
                <a href={c.url} rel="noopener">
                  {c.name}
                </a>
              ) : (
                c.name
              )}
            </>
          ))}
        </li>
      ))
    }
  </ul>

  <h2>Learning next</h2>
  <ul class="bullets">
    {profile.learning.map((l) => <li>{l.what}{l.by ? <span class="muted"> — by {l.by}</span> : null}</li>)}
  </ul>

  <h2>Contact</h2>
  <p>
    <a href={profile.links.booking} rel="noopener" data-track="book-call:contact">Book a call (Google Meet)</a> ·
    <a href={`mailto:${profile.email}`}>{profile.email}</a> ·
    <a href={profile.links.linkedin} rel="noopener" data-track="linkedin:contact">LinkedIn</a> ·
    <a href={profile.links.github} rel="noopener">GitHub</a>
  </p>
</Base>

<style>
  .roles {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  h1 {
    font-size: clamp(1.8rem, 4.5vw, 2.6rem);
    line-height: 1.15;
    margin: 0.4rem 0 0.8rem;
  }
  .lead {
    font-size: 1.1rem;
  }
  .meta {
    color: var(--muted);
    margin: 0.3rem 0 1rem;
  }
  .cta {
    margin-bottom: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .btn {
    display: inline-block;
    padding: 0.55rem 1rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--fg);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .btn:hover,
  .btn:focus-visible {
    border-color: var(--accent);
  }
  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--bg);
    font-weight: 600;
  }
  .sub {
    color: var(--muted);
    font-size: 0.85rem;
  }
  h2 {
    margin-top: 2.6rem;
  }
  .bullets li {
    margin-bottom: 0.45rem;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 0.8rem;
    list-style: none;
    padding: 0;
  }
  .card {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 1rem;
    background: var(--surface);
  }
  .card h3 {
    margin: 0.3rem 0;
    font-size: 1.05rem;
  }
  .card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .more .detail {
    margin-top: 0.5rem;
    color: var(--fg);
    font-size: 0.9rem;
  }
  .more .nums,
  .more .chips {
    margin-top: 0.5rem;
    font-size: 0.8rem;
  }
  .tag {
    font-size: 0.72rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .oss-h {
    margin: 1.4rem 0 0.3rem;
    font-size: 1.05rem;
  }
  .oss-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0.8rem;
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0.4rem;
  }
  .oss-cards h4 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
  }
  .oss-cards dl {
    margin: 0;
  }
  .oss-cards dt {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.5rem;
  }
  .oss-cards dd {
    margin: 0.1rem 0 0;
    font-size: 0.9rem;
  }
  .pr-links {
    margin: 0.7rem 0 0;
    font-size: 0.85rem;
  }
  .certs {
    padding-left: 1.2rem;
  }
  .certs li {
    margin-bottom: 0.25rem;
  }
</style>
