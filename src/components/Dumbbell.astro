---
/**
 * Dumbbell chart (before → after per row), static SVG, light/dark via CSS custom properties.
 * Palette: one hue, two ordinal shades (validated: light #86b6ef→#256abf, dark #5598e7→#9ec5f4).
 * Hover: native <title> per mark; a table view follows the chart.
 */
interface Row {
  label: string;
  from: number;
  to: number;
  note?: string;
}
interface RefLine {
  value: number;
  label: string;
}
interface Props {
  title: string;
  caption: string;
  rows: Row[];
  max: number;
  ticks: number[];
  unit?: string;
  fromLabel: string;
  toLabel: string;
  refs?: RefLine[];
  source: string;
}

const { title, caption, rows, max, ticks, unit = '', fromLabel, toLabel, refs = [], source } = Astro.props;

const W = 640;
const labelW = 150;
const right = 70;
const rowH = 46;
const top = 34;
const plotW = W - labelW - right;
const H = top + rows.length * rowH + 30;
const x = (v: number) => labelW + (Math.min(v, max) / max) * plotW;
const fmt = (v: number) => `${v}${unit}`;
const id = `db-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<figure class="viz-root dumbbell" aria-labelledby={`${id}-t`}>
  <figcaption>
    <strong id={`${id}-t`}>{title}</strong>
    <span class="cap">{caption}</span>
  </figcaption>
  <ul class="legend" aria-hidden="true">
    <li><span class="sw sw-from"></span>{fromLabel}</li>
    <li><span class="sw sw-to"></span>{toLabel}</li>
  </ul>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`${title}. ${caption}`}>
    {
      ticks.map((t) => (
        <g class="tick">
          <line x1={x(t)} x2={x(t)} y1={top - 8} y2={H - 26} />
          <text x={x(t)} y={H - 10} text-anchor="middle">
            {fmt(t)}
          </text>
        </g>
      ))
    }
    {
      refs.map((r) => (
        <g class="ref">
          <line x1={x(r.value)} x2={x(r.value)} y1={top - 18} y2={H - 26} />
          <text x={x(r.value) + 4} y={top - 20}>
            {r.label}
          </text>
        </g>
      ))
    }
    {
      rows.map((r, i) => {
        const cy = top + i * rowH + rowH / 2;
        const lo = Math.min(r.from, r.to);
        const hi = Math.max(r.from, r.to);
        return (
          <g class="row">
            <rect class="hit" x="0" y={cy - rowH / 2} width={W} height={rowH}>
              <title>{`${r.label}: ${fromLabel} ${fmt(r.from)} → ${toLabel} ${fmt(r.to)}${r.note ? ` (${r.note})` : ''}`}</title>
            </rect>
            <text class="rl" x={labelW - 12} y={cy + 4} text-anchor="end">
              {r.label}
            </text>
            <line class="bar" x1={x(lo)} x2={x(hi)} y1={cy} y2={cy} />
            <circle class="dot-from" cx={x(r.from)} cy={cy} r="7" />
            <circle class="dot-to" cx={x(r.to)} cy={cy} r="7" />
            <text class="val" x={x(hi) + 12} y={cy + 4}>
              {fmt(r.to)}
            </text>
            <text class="val val-from" x={x(lo) - 12} y={cy + 4} text-anchor="end">
              {r.from === r.to ? '' : fmt(r.from)}
            </text>
          </g>
        );
      })
    }
  </svg>
  <details class="table-view">
    <summary>Table view</summary>
    <table>
      <thead>
        <tr><th scope="col"></th><th scope="col">{fromLabel}</th><th scope="col">{toLabel}</th><th scope="col">Note</th></tr>
      </thead>
      <tbody>
        {
          rows.map((r) => (
            <tr>
              <th scope="row">{r.label}</th>
              <td>{fmt(r.from)}</td>
              <td>{fmt(r.to)}</td>
              <td>{r.note ?? ''}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </details>
  <p class="src">Source: {source}</p>
</figure>

<style>
  .viz-root {
    --from: #86b6ef;
    --to: #256abf;
    --grid: var(--line);
    --ink-2: var(--muted);
    margin: 1.5rem 0;
    padding: 1rem 1.1rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .viz-root {
      --from: #5598e7;
      --to: #9ec5f4;
    }
  }
  :global(:root[data-theme='dark']) .viz-root {
    --from: #5598e7;
    --to: #9ec5f4;
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .cap {
    color: var(--ink-2);
    font-size: 0.9rem;
  }
  .legend {
    display: flex;
    gap: 1.2rem;
    list-style: none;
    padding: 0;
    margin: 0.6rem 0 0;
    font-size: 0.82rem;
    color: var(--ink-2);
  }
  .sw {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 0.35rem;
    vertical-align: -1px;
  }
  .sw-from {
    background: var(--from);
  }
  .sw-to {
    background: var(--to);
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    font-size: 13px;
  }
  .tick line {
    stroke: var(--grid);
    stroke-width: 1;
  }
  .tick text,
  .ref text {
    fill: var(--ink-2);
    font-size: 11px;
  }
  .ref line {
    stroke: var(--ink-2);
    stroke-width: 1.2;
    stroke-dasharray: 4 3;
  }
  .rl {
    fill: var(--fg);
  }
  .val {
    fill: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .val-from {
    fill: var(--ink-2);
  }
  .bar {
    stroke: var(--grid);
    stroke-width: 3;
    stroke-linecap: round;
  }
  .dot-from {
    fill: var(--from);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .dot-to {
    fill: var(--to);
    stroke: var(--surface);
    stroke-width: 2;
  }
  .hit {
    fill: transparent;
  }
  .row:hover .hit {
    fill: color-mix(in srgb, var(--fg) 4%, transparent);
  }
  .table-view {
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }
  .table-view summary {
    cursor: pointer;
    color: var(--accent);
  }
  table {
    border-collapse: collapse;
    margin-top: 0.4rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.2rem 0.8rem 0.2rem 0;
    border-bottom: 1px solid var(--line);
  }
  .src {
    color: var(--ink-2);
    font-size: 0.78rem;
    margin: 0.5rem 0 0.4rem;
  }
</style>
