---
import Base from './Base.astro';

interface Fact {
  value: string;
  label: string;
}
interface Props {
  frontmatter: {
    title: string;
    kicker: string;
    summary: string;
    description: string;
    facts?: Fact[];
    snapshot?: string;
    tldr?: { problem: string; built: string; result: string };
  };
}

const { frontmatter: fm } = Astro.props;
---

<Base title={`${fm.title} — Vitalii Ryzhenko`} description={fm.description}>
  <article class="case">
    <p class="kicker">{fm.kicker}</p>
    <h1>{fm.title}</h1>
    <p class="summary">{fm.summary}</p>
    {
      fm.tldr && (
        <section class="tldr" aria-label="In 30 seconds">
          <h2>In 30 seconds</h2>
          <dl>
            <dt>Problem</dt>
            <dd>{fm.tldr.problem}</dd>
            <dt>Built</dt>
            <dd>{fm.tldr.built}</dd>
            <dt>Result</dt>
            <dd>{fm.tldr.result}</dd>
          </dl>
        </section>
      )
    }
    {
      fm.facts && (
        <ul class="facts">
          {fm.facts.map((f) => (
            <li>
              <span class="fv">{f.value}</span>
              <span class="fl">{f.label}</span>
            </li>
          ))}
        </ul>
      )
    }
    {fm.snapshot && <p class="snap">Numbers from snapshot {fm.snapshot} unless a section says otherwise.</p>}
    <slot />
  </article>
</Base>

<style>
  .kicker {
    margin: 0;
    color: var(--muted);
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  h1 {
    margin: 0.2rem 0 0.6rem;
  }
  .summary {
    font-size: 1.12rem;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 0.8rem;
    list-style: none;
    padding: 0;
    margin: 1.4rem 0 0.4rem;
  }
  .facts li {
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 0.7rem 0.8rem;
    background: var(--surface);
  }
  .fv {
    display: block;
    font-size: 1.6rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .fl {
    display: block;
    color: var(--muted);
    font-size: 0.85rem;
    line-height: 1.35;
  }
  .tldr {
    margin: 1.2rem 0 0;
    padding: 0.9rem 1.1rem;
    border-left: 4px solid var(--accent);
    border-radius: 0 10px 10px 0;
    background: var(--surface);
  }
  .tldr h2 {
    margin: 0 0 0.4rem;
    font-size: 0.8rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .tldr dl {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0.35rem 0.8rem;
    margin: 0;
  }
  .tldr dt {
    font-weight: 600;
  }
  .tldr dd {
    margin: 0;
  }
  @media (max-width: 560px) {
    .tldr dl {
      grid-template-columns: 1fr;
    }
  }
  .case :global(details.more) {
    margin: 1rem 0;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .case :global(details.more > summary) {
    cursor: pointer;
    color: var(--accent);
    font-weight: 600;
  }
  .snap {
    color: var(--muted);
    font-size: 0.8rem;
  }
  .case :global(h2) {
    margin-top: 2.4rem;
  }
  .case :global(table) {
    border-collapse: collapse;
    font-size: 0.9rem;
    width: 100%;
  }
  .case :global(th),
  .case :global(td) {
    text-align: left;
    vertical-align: top;
    padding: 0.35rem 0.7rem 0.35rem 0;
    border-bottom: 1px solid var(--line);
  }
  .case :global(.note) {
    border-left: 3px solid var(--accent);
    padding: 0.2rem 0 0.2rem 0.9rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
</style>
