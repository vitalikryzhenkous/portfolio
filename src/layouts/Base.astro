---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <!-- hidden until launch: remove noindex + robots.txt Disallow when the site is ready -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav aria-label="Main">
        <a href={`${base}/`} class="brand">Vitalii Ryzhenko</a>
        <a href={`${base}/how-i-work/`}>How I work</a>
      </nav>
    </header>
    <main class:list={[{ wide }]}>
      <slot />
    </main>
  </body>
</html>
