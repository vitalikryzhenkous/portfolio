---
import { createHash } from 'node:crypto';
import '../styles/global.css';
import og from '../data/og.json';
import profile from '../data/profile.json';

interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Main navigation; the current section is marked for screen readers (aria-current) and styled.
const here = Astro.url.pathname.replace(/\/$/, '');
const nav = [
  { href: `${base}/work/`, label: 'Case studies', section: `${base}/work` },
  { href: `${base}/stack/`, label: 'Stack', section: `${base}/stack` },
  { href: `${base}/cv/`, label: 'CV', section: `${base}/cv` },
].map((n) => ({ ...n, current: here === n.section || here.startsWith(`${n.section}/`) }));

// Canonical URL and link-preview image for this page.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const path = Astro.url.pathname.replace(base, '').replace(/^\/|\/$/g, '');
const slug = path === '' ? 'home' : path.replace(/\//g, '-');
const ogSlug = slug in og.pages ? slug : 'home';
// Version the image URL by its text: link-preview caches (LinkedIn, Slack) key on the URL, so a changed
// headline must produce a new URL or the old picture keeps showing.
const ogPage = og.pages[ogSlug as keyof typeof og.pages];
const ogVersion = createHash('sha256').update(`${ogPage.kicker}|${ogPage.title}`).digest('hex').slice(0, 8);
const ogImage = new URL(`${base}/og/${ogSlug}.png?v=${ogVersion}`, Astro.site).href;

// Machine-readable profile (schema.org Person) for search engines and AI agents.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.roles[0],
  url: new URL(`${base}/`, Astro.site).href,
  email: `mailto:${profile.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Poznań', addressCountry: 'PL' },
  sameAs: [profile.links.linkedin, profile.links.github],
  knowsAbout: ['Applied AI', 'LLM evaluation', 'Model Context Protocol', 'AI agents', 'TypeScript', 'Angular', 'React', '.NET'],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={`${base}/sitemap-index.xml`} />
    <meta property="og:type" content={slug.startsWith('work-') ? 'article' : 'website'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- Anonymous page counts, no cookies (GoatCounter). Pinned v4 script with SRI. -->
    <script
      is:inline
      data-goatcounter="https://vitaliius.goatcounter.com/count"
      async
      src="https://gc.zgo.at/count.v4.js"
      integrity="sha384-nRw6qfbWyJha9LhsOtSb2YJDyZdKvvCFh0fJYlkquSFjUxp9FVNugbfy8q1jdxI+"
      crossorigin="anonymous"></script>
    <script is:inline>
      // Apply a saved theme before first paint (no flash). Storage can be blocked: then follow the OS.
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <div class="identity">
          <a href={`${base}/`} class="brand">{profile.name}</a>
          <p class="contacts">
            <a href={`mailto:${profile.email}`} data-track="email:header">{profile.email}</a>
            <span aria-hidden="true">·</span>
            <a href={profile.links.linkedin} rel="noopener" data-track="linkedin:header">LinkedIn</a>
            <span aria-hidden="true">·</span>
            <a href={profile.links.github} rel="noopener" data-track="github:header">GitHub</a>
            <span aria-hidden="true">·</span>
            <a href={profile.links.booking} rel="noopener" data-track="book-call:header">Book a call</a>
          </p>
        </div>
        <nav aria-label="Main">
          {
            nav.map((n) => (
              <a href={n.href} class="nav-link" aria-current={n.current ? 'page' : undefined}>
                {n.label}
              </a>
            ))
          }
          <button type="button" class="theme-toggle" id="theme-toggle">Theme</button>
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1" class:list={[{ wide }]}>
      <slot />
    </main>
    <footer class="site-footer">
      <p>
        Privacy: no cookies; anonymous page and click counts via
        <a href="https://www.goatcounter.com/" rel="noopener">GoatCounter</a>.
      </p>
    </footer>
    <script>
      const btn = document.getElementById('theme-toggle');
      const root = document.documentElement;
      const current = (): 'light' | 'dark' =>
        root.dataset.theme === 'light' || root.dataset.theme === 'dark'
          ? root.dataset.theme
          : window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
      // Visible text is the accessible name (WCAG 2.5.3): it says what the button switches to.
      const label = () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        if (btn) btn.textContent = next === 'light' ? 'Light theme' : 'Dark theme';
      };
      label();
      // Analytics events (anonymous): elements with data-track, and opening a collapsed section.
      import('../lib/track').then(({ track }) => {
        document.addEventListener('click', (e) => {
          const el = (e.target as HTMLElement).closest<HTMLElement>('[data-track]');
          if (el?.dataset['track']) track(el.dataset['track'], el.textContent?.trim().slice(0, 80));
        });
        document.addEventListener(
          'toggle',
          (e) => {
            const d = e.target as HTMLDetailsElement;
            if (d.open && d.matches('details')) {
              const label = d.querySelector('summary')?.textContent?.trim().slice(0, 60) ?? '';
              track(`open:${location.pathname.replace(/\/$/, '').split('/').pop() || 'home'}:${label.toLowerCase().replace(/[^a-z0-9]+/g, '-').slice(0, 40)}`, label);
            }
          },
          true,
        );
      });
      btn?.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch {}
        label();
      });
    </script>
  </body>
</html>
