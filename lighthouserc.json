{
  "ci": {
    "collect": {
      "startServerCommand": "npx astro preview --host 127.0.0.1 --port 4321",
      "startServerReadyPattern": "running",
      "url": [
        "http://127.0.0.1:4321/portfolio/",
        "http://127.0.0.1:4321/portfolio/work/jev/",
        "http://127.0.0.1:4321/portfolio/work/platform/",
        "http://127.0.0.1:4321/portfolio/how-i-work/",
        "http://127.0.0.1:4321/portfolio/cv/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "lhci-report"
    }
  }
}
